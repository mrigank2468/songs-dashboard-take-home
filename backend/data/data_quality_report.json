  "rules": {
    "dedupe_key": "id (surrounding whitespace trimmed)",
    "precedence": [
      "part1",
      "part2"
    ],
    "conflict_rule": "both sources have a valid value and they differ: the earlier source in 'precedence' is kept and the disagreement is listed under 'conflicts'",
    "fill_rule": "the kept source has no value for a field (column_not_provided, missing_value or invalid_value) and a later source has a valid one: the later source's value is used and listed under 'filled_from_other_source' with the kept source's original value and reason. A later source never overrides a valid earlier value.",
    "null_like_values": {
      "forms": [
        "missing_key",
        "null",
        "empty_string",
        "placeholder_string"
      ],
      "placeholder_strings": [
        "n/a",
        "na",
        "nan",
        "none",
        "null"
      ],
      "note": "matched case-insensitively after trimming; an empty or whitespace-only string is empty_string"
    },
    "numeric_string_format": "[+-]?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)",
    "duplicate_title_key": "NFKC-normalized, casefolded, whitespace-collapsed; diacritics are not folded",
    "unit_interval_fields": [
      "danceability",
      "energy",
      "acousticness",
      "valence"
    ],
    "tempo_valid_range_bpm": "(0, 400]",
    "duration_seconds_rule": {
      "suspect_below_ms": 1000,
      "plausible_song_ms": [
        30000,
        1800000
      ],
      "plausible_ms_per_segment": [
        100.0,
        600.0
      ]
    }
  }
